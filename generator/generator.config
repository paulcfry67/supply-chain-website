[grok]
grok_api_key = REDACTED_XAI_KEY
model = grok-2-1212
temperature = 0.3
max_tokens = 10000

[output]
output_dir = ../content/posts
hugo_build = true
min_chars = 6000
max_chars = 15000

[logging]
log_level = INFO

[email]
alert_email = 
smtp_server = smtp.gmail.com
smtp_port = 587
smtp_username = 
smtp_password = 

[prompts]
site_prompt_file = site_prompt.txt
system_prompt_file = system_prompt.txt

[live_search]
search_mode = auto
search_sources = web,news,x
max_search_results = 20
return_citations = true
search_from_date = 
search_to_date = 
excluded_x_handles = 
post_favorite_count = 0
post_view_count = 0
rss_links =