# Generator Configuration File
# This file contains all configurable parameters for the Supply Chain Daily News Generator
# Lines starting with # are comments

[grok]
grok_api_key =
grok_base_url = https://api.x.ai/v1
model = grok-4.3

# API Generation Parameters
temperature = 0.2
max_tokens = 16000
presence_penalty = 0.1
frequency_penalty = 0.1

[output]
output_dir = ../content/post
#hugo_build = true
min_chars = 6000
max_chars = 30000

[logging]
log_level = INFO

[email]
alert_email = paul.fry@flexresourcing.com
smtp_server = smtp.gmail.com
smtp_port = 587
smtp_username = 
smtp_password = 

[prompts]
daily_prompt_file = site_prompt.txt
system_prompt_file = system_prompt.txt

[live_search]
#search_mode = auto
#search_sources = web,news,x
#max_search_results = 20
#return_citations = true
#search_from_date = 
#search_to_date = 
#excluded_x_handles = 
#post_favorite_count = 0
#post_view_count = 0
